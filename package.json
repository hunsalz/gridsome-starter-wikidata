{
  "name": "gridsome-starter-wikidata",
  "private": true,
  "scripts": {
    "build": "gridsome build",
    "develop": "gridsome develop",
    "explore": "gridsome explore",
    "deploy": "gh-pages -d dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,vue,scss}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,scss}\"",
    "verify": "node scripts/test-checklist.js",
    "check:all": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "gridsome",
    "wikidata",
    "pwa",
    "grid",
    "masonry",
    "tagging"
  ],
  "dependencies": {
    "@gridsome/plugin-sitemap": "^0.4.0",
    "@gridsome/source-filesystem": "^0.6.2",
    "@gridsome/transformer-remark": "^0.6.4",
    "file-saver": "^2.0.5",
    "gridsome": "^0.7.23",
    "gridsome-plugin-pwa": "0.0.22",
    "gridsome-source-wikidata": "0.1.5",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.29.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-lodash": "^8.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "lodash": "^4.18.1",
    "prettier": "^3.8.2",
    "sass": "^1.99.0",
    "sass-loader": "^10.5.2",
    "vue-eslint-parser": "^10.4.0",
    "@vue/test-utils": "^1.3.6",
    "@vue/vue2-jest": "^29.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "babel-jest": "^29.7.0"
  }
}
